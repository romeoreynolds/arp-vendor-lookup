#!/bin/sh
set -e
# Remove bytecode Python wrote next to the package
rm -rf /usr/lib/python3/dist-packages/arp_vendor_lookup/__pycache__ 2>/dev/null || true
rmdir /usr/lib/python3/dist-packages/arp_vendor_lookup 2>/dev/null || true
if [ "$1" = "remove" ] || [ "$1" = "purge" ]; then
    command -v update-desktop-database >/dev/null 2>&1 && update-desktop-database -q /usr/share/applications || true
fi
exit 0
